// Copie este arquivo para secrets.h e preencha com suas credenciais.
// NÃO comite secrets.h no controle de versão!
//
// Estas constantes são usadas APENAS na primeira gravação via Serial
// para popular a NVS. Depois disso, os valores ficam na flash e
// você pode apagar secrets.h se quiser.
// ============================================================

#ifndef SECRETS_H
#define SECRETS_H

// Credenciais do Spotify Developer App
// Obtenha em: https://developer.spotify.com/dashboard
#define SPOTIFY_CLIENT_ID     "seu_client_id_aqui"
#define SPOTIFY_CLIENT_SECRET "seu_client_secret_aqui"

// Refresh token obtido rodando o script Python (tools/get_refresh_token.py)
#define SPOTIFY_REFRESH_TOKEN "seu_refresh_token_aqui"

#endif // SECRETS_H
